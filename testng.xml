<?xml version="1.0" encoding="UTF-8"?>



<suite name="Amazon Cross Browser Suite"
       parallel="tests"
       thread-count="3">

    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="Devops_Assignment.Devops_Assignment.AmazonTest"/>
        </classes>
    </test>

    <test name="Firefox Test">
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="Devops_Assignment.Devops_Assignment.AmazonTest"/>
        </classes>
    </test>

    <test name="Edge Test">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="Devops_Assignment.Devops_Assignment.AmazonTest"/>
        </classes>
    </test>

</suite>